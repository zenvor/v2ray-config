      ],
      "dns.alidns.com": [
        "223.5.5.5",
        "223.6.6.6"
      ]
    },
    "queryStrategy": "UseIP",
    "disableFallbackIfMatch": true,
    "servers": [
      {
        "address": "https://dns.alidns.com/dns-query",
        "domains": [
          "geosite:cn",
          "geosite:private"
        ],
        "skipFallback": true,
        "tag": "dns-domestic"
      },
      {
        "address": "https://dns.google/dns-query",
        "tag": "dns-remote"
      },
      {
        "address": "https://cloudflare-dns.com/dns-query",
        "tag": "dns-remote"
      }
    ]
  },
